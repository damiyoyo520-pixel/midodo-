# ============ 后端配置 ============
# DATABASE
DATABASE_URL=postgres://drama_user:drama_password@localhost:5432/drama_db

# REDIS
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# 服务器
NODE_ENV=development
PORT=9000
ADMIN_PORT=7001

# ============ 支付配置 ============
# 支付宝
ALIBABA_APPID=your_alipay_app_id
ALIBABA_PRIVATE_KEY=your_alipay_private_key
ALIBABA_PUBLIC_KEY=your_alipay_public_key
ALIBABA_NOTIFY_URL=http://localhost:9000/webhooks/alipay

# 微信支付
WECHAT_APPID=your_wechat_app_id
WECHAT_MCHID=your_wechat_mch_id
WECHAT_API_KEY=your_wechat_api_key
WECHAT_NOTIFY_URL=http://localhost:9000/webhooks/wechat

# ============ AI 配置 ============
# ChatGLM（剧本生成）
CHATGLM_API_KEY=your_chatglm_api_key
CHATGLM_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
CHATGLM_MODEL=glm-4

# ModelScope（文本转视频）
MODELSCOPE_API_KEY=your_modelscope_token
MODELSCOPE_MODEL_ID=iic/text-to-video-synthesis

# ============ 存储配置 ============
# Minio (本地开发) / AWS S3 (生产)
OSS_TYPE=minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=drama-assets

# AWS S3 (可选)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_S3_BUCKET=drama-assets-prod

# ============ 前端配置 ============
VITE_API_BASE_URL=http://localhost:9000
VITE_ADMIN_BASE_URL=http://localhost:7001
